diff --git a/src/fftw.cpp b/src/fftw.cpp
index 1a7ce75..67ead59 100644
--- a/src/fftw.cpp
+++ b/src/fftw.cpp
@@ -45,6 +45,42 @@
 
 #include "src/macros.h"
 #include "src/fftw.h"
+
+static int fftw_big_threads = 1;
+static bool fftw_threads_initialised = false;
+
+void setFftwBigTransformThreads(int nr_threads)
+{
+#ifdef RELION_FFTW_THREADS
+	#pragma omp critical(FourierTransformer_fftw_plan)
+	{
+		if (!fftw_threads_initialised)
+		{
+#ifdef RELION_SINGLE_PRECISION
+			fftwf_init_threads();
+#else
+			fftw_init_threads();
+#endif
+			fftw_threads_initialised = true;
+		}
+		// FFTW_ESTIMATE plans for 720^3 stop scaling past ~4 threads (5.8 s at 1, 3.0 at 4, 7.8 at 8).
+		fftw_big_threads = std::max(1, std::min(nr_threads, 4));
+	}
+#endif
+}
+
+// Called inside the plan critical section.
+static void planThreadsFor(size_t nelem)
+{
+#ifdef RELION_FFTW_THREADS
+	int n = (nelem >= ((size_t)1 << 22)) ? fftw_big_threads : 1;
+#ifdef RELION_SINGLE_PRECISION
+	fftwf_plan_with_nthreads(n);
+#else
+	fftw_plan_with_nthreads(n);
+#endif
+#endif
+}
 #include "src/args.h"
 #include <string.h>
 #include <math.h>
@@ -120,6 +156,22 @@ void FourierTransformer::cleanup()
 	clear();
 	// Then clean up all the junk fftw keeps lying around
 	// SOMEHOW THE FOLLOWING IS NOT ALLOWED WHEN USING MULTPLE TRANSFORMER OBJECTS....
+#ifdef RELION_FFTW_THREADS
+	// fftw_init_threads() adds the threaded solvers only to the planner alive at that moment, and fftw_cleanup()
+	// destroys it. A bare cleanup therefore leaves every later big plan threaded only deep inside its loops
+	// (~500k thread spawns per 720^3 transform, 10x slower). Tear down and re-initialise the threads layer instead.
+	if (fftw_threads_initialised)
+	{
+#ifdef RELION_SINGLE_PRECISION
+		fftwf_cleanup_threads();
+		fftwf_init_threads();
+#else
+		fftw_cleanup_threads();
+		fftw_init_threads();
+#endif
+		return;
+	}
+#endif
 #ifdef RELION_SINGLE_PRECISION
 	fftwf_cleanup();
 #else
@@ -215,6 +267,7 @@ void FourierTransformer::setReal(MultidimArray<RFLOAT> &input, bool force_new_pl
 
 		#pragma omp critical(FourierTransformer_fftw_plan)
 		{
+			planThreadsFor(MULTIDIM_SIZE(*fReal));
 #ifdef RELION_SINGLE_PRECISION
 			fPlanForward = fftwf_plan_dft_r2c(ndim, N, MULTIDIM_ARRAY(*fReal),
 							  (fftwf_complex*) MULTIDIM_ARRAY(fFourier), FFTW_ESTIMATE);
@@ -292,6 +345,7 @@ void FourierTransformer::setReal(MultidimArray<Complex > &input, bool force_new_
 		RCTIC(TIMING_FFTW_PLAN);
 		#pragma omp critical(FourierTransformer_fftw_plan)
 		{
+			planThreadsFor(MULTIDIM_SIZE(*fComplex));
 #ifdef RELION_SINGLE_PRECISION
 			fPlanForward = fftwf_plan_dft(ndim, N, (fftwf_complex*) MULTIDIM_ARRAY(*fComplex),
 						      (fftwf_complex*) MULTIDIM_ARRAY(fFourier), FFTW_FORWARD, FFTW_ESTIMATE);
