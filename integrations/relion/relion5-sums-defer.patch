+#ifdef ALTCPU
+#include <mutex>
+#include <vector>
+// Deferred splat. A slice pixel lands in 8 voxels of a volume far larger than the caches, so splatting a
+// particle as it comes misses the cache on nearly every pixel. Instead the kernel appends the pixel (already
+// folded to xp >= 0) to a log, and once enough pixels are waiting the log is sorted by the volume tile it lands
+// in (z plane, band of 32 rows) and applied tile by tile: the adds then hit a tile that sits in L2 and the
+// volume is streamed once per batch. The sums are the same adds in another order per voxel.
+// TT_RELION_SPLAT_DEFER=0 keeps RELION's direct splat; TT_RELION_SPLAT_BATCH is the batch in pixels.
+struct AccSplatPixel { XFLOAT xp, yp, zp, real, imag, weight; };
+struct AccSplatLog
+{
+	std::mutex lists, flushing;
+	std::vector<std::vector<AccSplatPixel> > pending, spare;
+	size_t pending_pixels, batch_pixels;
+	std::vector<AccSplatPixel> sorted;
+	std::vector<unsigned> start;
+	AccSplatLog(): pending_pixels(0), batch_pixels(4u << 20) {}
+};
+#endif
