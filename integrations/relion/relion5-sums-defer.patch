+#ifdef ALTCPU
+#include "src/acc/tt/tt_profile.h"
+void AccBackprojector::splatTake(std::vector<AccSplatPixel> &log)
+{
+	std::lock_guard<std::mutex> l(splat->lists);
+	if (!splat->spare.empty()) { log.swap(splat->spare.back()); splat->spare.pop_back(); }
+	log.clear();
+}
+
+void AccBackprojector::splatGive(std::vector<AccSplatPixel> &log)
+{
+	size_t waiting;
+	{
+		std::lock_guard<std::mutex> l(splat->lists);
+		splat->pending_pixels += log.size();
+		splat->pending.emplace_back();
+		splat->pending.back().swap(log);
+		waiting = splat->pending_pixels;
+	}
+	// One thread applies at a time and the others keep appending. If they outrun it, a thread that finds two
+	// batches waiting queues behind the one applying, so the log stays bounded.
+	if (waiting >= splat->batch_pixels) splatFlush(waiting >= 2 * splat->batch_pixels);
+}
+
+void AccBackprojector::splatFlush(bool wait, bool tail)
+{
+	if (!splat) return;
+	std::unique_lock<std::mutex> f(splat->flushing, std::defer_lock);
+	if (wait) f.lock(); else if (!f.try_lock()) return;      // another thread is applying: it or the next batch takes these
+	// a flush inside a kernel call is counted in RELION's "backproject" region; the one before a read is not
+	static const char *region = "splat_flush_tail";
+	if (tail) TTProf::tic(region);
+	std::vector<std::vector<AccSplatPixel> > batch;
+	{
+		std::lock_guard<std::mutex> l(splat->lists);
+		batch.swap(splat->pending);
+		splat->pending_pixels = 0;
+	}
+	size_t n = 0;
+	for (size_t i = 0; i < batch.size(); i++) n += batch[i].size();
+	if (n)
+	{
+		// stable counting sort by tile = (lower z plane, band of 32 rows of the lower y)
+		const int BAND = 32, bands = (mdlY + BAND - 1) / BAND;
+		std::vector<unsigned> &start = splat->start;
+		start.assign((size_t)mdlZ * bands + 1, 0);
+		#define TT_SPLAT_TILE(p) ((size_t)((int)floorf((p).zp) - mdlInitZ) * bands + ((int)floorf((p).yp) - mdlInitY) / BAND)
+		for (size_t i = 0; i < batch.size(); i++)
+			for (size_t k = 0; k < batch[i].size(); k++) start[TT_SPLAT_TILE(batch[i][k]) + 1]++;
+		for (size_t t = 0; t + 1 < start.size(); t++) start[t + 1] += start[t];
+		if (splat->sorted.size() < n) splat->sorted.resize(n);
+		AccSplatPixel *sorted = &splat->sorted[0];
+		for (size_t i = 0; i < batch.size(); i++)
+			for (size_t k = 0; k < batch[i].size(); k++) sorted[start[TT_SPLAT_TILE(batch[i][k])]++] = batch[i][k];
+		#undef TT_SPLAT_TILE
+
+		// the splat of CpuKernels::backprojectRef3D, same weights and products; only this thread writes the volume
+		const size_t mdl_x = mdlX, mdl_x_mdl_y = (size_t)mdlX * (size_t)mdlY;
+		XFLOAT *v = d_mdlReal;
+		for (size_t i = 0; i < n; i++)
+		{
+			const AccSplatPixel &p = sorted[i];
+			int x0 = floorf(p.xp);
+			XFLOAT fx = p.xp - x0;
+			int y0 = floorf(p.yp);
+			XFLOAT fy = p.yp - y0;
+			y0 -= mdlInitY;
+			int z0 = floorf(p.zp);
+			XFLOAT fz = p.zp - z0;
+			z0 -= mdlInitZ;
+
+			XFLOAT mfx = (XFLOAT)1.0 - fx;
+			XFLOAT mfy = (XFLOAT)1.0 - fy;
+			XFLOAT mfz = (XFLOAT)1.0 - fz;
+			XFLOAT mfz_mfy = mfz * mfy;
+
+			XFLOAT dd000 = mfz_mfy * mfx;
+			XFLOAT dd001 = mfz_mfy - dd000;
+			XFLOAT dd010 = (mfz - mfz_mfy) * mfx;
+			XFLOAT dd011 = (mfz - mfz_mfy) - dd010;
+			XFLOAT dd100 = (mfy - mfz_mfy) * mfx;
+			XFLOAT dd101 = (mfy - mfz_mfy) - dd100;
+			XFLOAT dd110 = (1 - mfz - mfy + mfz_mfy) * mfx;
+			XFLOAT dd111 = (1 - mfz - mfy + mfz_mfy) - dd110;
+
+			XFLOAT *q = v + 3UL * ((size_t)z0 * mdl_x_mdl_y + (size_t)y0 * mdl_x + (size_t)x0);
+			q[0] += dd000 * p.real; q[1] += dd000 * p.imag; q[2] += dd000 * p.weight;
+			q[3] += dd001 * p.real; q[4] += dd001 * p.imag; q[5] += dd001 * p.weight;
+			q += 3UL * mdl_x;
+			q[0] += dd010 * p.real; q[1] += dd010 * p.imag; q[2] += dd010 * p.weight;
+			q[3] += dd011 * p.real; q[4] += dd011 * p.imag; q[5] += dd011 * p.weight;
+			q += 3UL * (mdl_x_mdl_y - mdl_x);
+			q[0] += dd100 * p.real; q[1] += dd100 * p.imag; q[2] += dd100 * p.weight;
+			q[3] += dd101 * p.real; q[4] += dd101 * p.imag; q[5] += dd101 * p.weight;
+			q += 3UL * mdl_x;
+			q[0] += dd110 * p.real; q[1] += dd110 * p.imag; q[2] += dd110 * p.weight;
+			q[3] += dd111 * p.real; q[4] += dd111 * p.imag; q[5] += dd111 * p.weight;
+		}
+	}
+	std::lock_guard<std::mutex> l(splat->lists);
+	for (size_t i = 0; i < batch.size(); i++)
+	{
+		batch[i].clear();
+		splat->spare.emplace_back();
+		splat->spare.back().swap(batch[i]);
+	}
+	if (tail) TTProf::toc(region);
+}
