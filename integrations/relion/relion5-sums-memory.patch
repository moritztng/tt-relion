-	memcpy(r, d_mdlReal,   mdlXYZ * sizeof(XFLOAT));
-	memcpy(i, d_mdlImag,   mdlXYZ * sizeof(XFLOAT));
-	memcpy(w, d_mdlWeight, mdlXYZ * sizeof(XFLOAT));
+	for (size_t n = 0; n < mdlXYZ; n++)
