diff --git a/src/acc/acc_backprojector.h b/src/acc/acc_backprojector.h
index 5946cb85..f96a5273 100644
--- a/src/acc/acc_backprojector.h
+++ b/src/acc/acc_backprojector.h
@@ -17,6 +17,18 @@ using deviceStream_t = float;
 #include "src/acc/settings.h"
 #include "src/acc/acc_ptr.h"
 
+// Volumes that are gathered from or scattered into at random (the reference, the backprojected sums) sit on
+// 2 MB pages: with 4 kB pages nearly every access is a TLB miss on top of its cache miss. NULL = out of memory.
+#include <sys/mman.h>
+static inline void *allocHugePages(size_t bytes)
+{
+	const size_t huge = (size_t)2 << 20;
+	void *p = NULL;
+	if (posix_memalign(&p, bytes < huge ? MEM_ALIGN : huge, bytes)) return NULL;
+	if (bytes >= huge) madvise(p, bytes, MADV_HUGEPAGE);
+	return p;
+}
+
 #ifdef ALTCPU
 #  include <tbb/spin_mutex.h>
 #endif
@@ -38,6 +50,8 @@ public:
 	size_t allocaton_size;
 	size_t voxelCount;
 
+	// On the CPU one block, a voxel's (real, imag, weight) side by side: element n of each is p[3 * n].
+	// A splat then touches 4 cache lines per pixel instead of 12.
 	XFLOAT *d_mdlReal, *d_mdlImag, *d_mdlWeight;
 
 	deviceStream_t stream;
