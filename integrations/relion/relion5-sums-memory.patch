-	memset(d_mdlImag,     0, mdlXYZ * sizeof(XFLOAT));
-	memset(d_mdlWeight,   0, mdlXYZ * sizeof(XFLOAT));
+	memset(d_mdlReal, 0, 3 * mdlXYZ * sizeof(XFLOAT));
 #endif
 
     voxelCount = mdlXYZ;
@@ -131,9 +129,12 @@ void AccBackprojector::getMdlData(XFLOAT *r, XFLOAT *i, XFLOAT * w)
 	stream->syclMemcpy(w, d_mdlWeight, mdlXYZ * sizeof(XFLOAT));
 	stream->waitAll();
