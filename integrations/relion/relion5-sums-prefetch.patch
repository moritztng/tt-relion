@@ -112,6 +112,9 @@ void wavg_ref3D(
 				wdiff2s_AA[x] = g_wdiff2s_AA[pixel + x];
 			}
 
+			if (REF3D)
+				projector.prefetch3Dmodel(xstart, xend, y, e0, e1, e3, e4, e6, e7);
+
 #if _OPENMP >= 201307	// For OpenMP 4.0 and later
 			#pragma omp simd simdlen(SIMD_LEN)
 #endif
