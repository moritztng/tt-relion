+// Which orientations and which translations have a sample at or above significant_weight. The weighted-sum
+// kernels add nothing for the rest, so they skip those orientations and build no phase table for those translations.
+inline void  markSignificant(const XFLOAT  *weights,
+                             unsigned long  orientation_num,
+                             unsigned long  trans_num,
+                             XFLOAT         significant_weight,
+                             std::vector<char> &orientation,
+                             std::vector<char> &translation)
+{
+	orientation.assign(orientation_num, 0);
+	translation.assign(trans_num, 0);
+	for (unsigned long o = 0; o < orientation_num; o++)
+		for (unsigned long t = 0; t < trans_num; t++)
+			if (weights[o * trans_num + t] >= significant_weight)
+				orientation[o] = translation[t] = 1;
+}
