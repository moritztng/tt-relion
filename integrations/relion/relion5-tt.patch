+#ifdef _TT_ENABLED
+#include "src/acc/tt/tt_bridge.h"
+
+// The reference for orientation_num orientations, projected by RELION's own projector in the
+// calling thread, as the bridge takes it: [orientation_num][2 * image_size], real then imag.
+// Pixels outside the projector's radius stay 0, as RELION's kernels read them.
+static const float *ttProjectRef(AccProjectorKernel &projector, const XFLOAT *eulers,
+                                 long orientation_num, long image_size)
+{
+	thread_local std::vector<float> ref;
+	const long P = image_size;
+	ref.assign((size_t)orientation_num * 2 * P, 0.f);
+	for (long o = 0; o < orientation_num; o++)
+	{
+		const XFLOAT *e = eulers + 9 * o;
+		float *re = ref.data() + 2 * P * o, *im = re + P;
+		for (long p = 0; p < P; p++)
+		{
+			int x = (int)(p % projector.imgX), y = (int)(p / projector.imgX);
+			if (y > projector.maxR)
+				y -= projector.imgY;
+			projector.project3Dmodel(x, y, e[0], e[1], e[3], e[4], e[6], e[7], re[p], im[p]);
+		}
+	}
+	return ref.data();
+}
+#endif
